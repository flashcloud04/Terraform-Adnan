pipeline {
    agent any

    stages {
        stage('stage 1') {
            steps {
                sh 'terraform init'
            }
        }

        stage('stage 2') {
            steps {
                sh 'terraform plan'
            }
        }
        stage('stage 3') {
            steps {
                sh 'terraform apply -auto-approve'
            }
        }
    }
}
